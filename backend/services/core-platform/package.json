{
  "name": "@infra/core-platform-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "CORE_PLATFORM_ENV=local NODE_ENV=development tsx watch src/index.ts",
    "dev:development": "CORE_PLATFORM_ENV=development NODE_ENV=development tsx watch src/index.ts",
    "dev:production": "CORE_PLATFORM_ENV=production NODE_ENV=production tsx watch src/index.ts",
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/index.js",
    "start:local": "CORE_PLATFORM_ENV=local NODE_ENV=development node dist/index.js",
    "start:development": "CORE_PLATFORM_ENV=development NODE_ENV=development node dist/index.js",
    "start:production": "CORE_PLATFORM_ENV=production NODE_ENV=production node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "openapi:validate": "tsx src/docs/validate-openapi.ts"
  },
  "dependencies": {
    "@infra/shared-auth": "file:../../packages/shared-auth",
    "@infra/shared-db": "file:../../packages/shared-db",
    "@infra/shared-errors": "file:../../packages/shared-errors",
    "@infra/shared-observability": "file:../../packages/shared-observability",
    "@infra/shared-permissions": "file:../../packages/shared-permissions",
    "@infra/shared-validation": "file:../../packages/shared-validation",
    "@sentry/node": "^10.45.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.0.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^9.17.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.1"
  }
}

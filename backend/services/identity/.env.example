# Identity Service — Environment Variables (production template)
# Copy this file to .env and replace all placeholder values.
# Never commit .env to source control.

# ── Service ──────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=production
LOG_LEVEL=info

# ── Supabase (required) — get from https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# WARNING: Service role key bypasses RLS. Keep secret. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# ── CORS — comma-separated list of trusted front-end origins ─────────────────
# Example: http://localhost:3000,https://app.yourdomain.com
ALLOWED_ORIGINS=https://app.example.com

# ── Cookie (recommended; required in production) ────────────────────────────
# Use at least 32 characters. Generate with: openssl rand -hex 32
COOKIE_SECRET=replace-with-32-plus-char-random-secret

# ── Sentry (required in production by env schema) ————————————————
SENTRY_DSN=https://replace@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# ── Redis (optional) — required before multi-replica deployment —————————————
# REDIS_URL=redis://localhost:6379

# ── Internal API (optional) — server-to-server token verification ——————————
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=replace-with-32-plus-char-internal-secret

# ── Logging (optional) — local file transport for debugging —————————————
# LOG_FILE=./logs/identity.log

# ── Build metadata (optional) — used for Sentry release correlation ——————
GIT_SHA=replace-with-git-sha
SENTRY_RELEASE=replace-with-release-id

# Frontend app environment variables (production template)
# Copy to .env.local for local dev or to your deployment environment settings.

# Public frontend base URL (used for redirects, callback links, and client-side absolute URLs).
NEXT_PUBLIC_BASE_URL=https://app.example.com

# Server-side URL used by Next.js API proxy and server auth checks.
# Must point to your deployed identity service URL.
IDENTITY_SERVICE_URL=https://identity.example.com

# Public Supabase values used by lib/supabase/client.browser.ts.
# These are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Optional placeholders for future frontend API integrations.
# NEXT_PUBLIC_API_BASE_URL=https://app.example.com/api
# NEXT_PUBLIC_API_KEY=
